{
    "version": "2.0.0",
    "tasks": [
        {
            // Builds wasm/game.wasm and copies GXPEngine/Assets to assets/ (see GXPEngine/GXPEngine.csproj).
            // Uses the repo-local .NET 10 SDK and WASI SDK in .tools/.
            "label": "Build WASM (release)",
            "type": "process",
            "command": "${workspaceFolder}/.tools/dotnet/dotnet.exe",
            "args": [
                "publish",
                "${workspaceFolder}/GXPEngine/GXPEngine.csproj",
                "-c",
                "Release",
                "-nologo"
            ],
            "options": {
                "env": {
                    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
                }
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            // Self-contained dist/ folder for a portfolio site or any static host (see README.md).
            "label": "Build portfolio (dist)",
            "type": "process",
            "command": "${workspaceFolder}/.tools/dotnet/dotnet.exe",
            "args": [
                "publish",
                "${workspaceFolder}/GXPEngine/GXPEngine.csproj",
                "-c",
                "Release",
                "-p:WebDist=true",
                "-nologo"
            ],
            "options": {
                "env": {
                    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
                }
            },
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Build WASM (debug)",
            "type": "process",
            "command": "${workspaceFolder}/.tools/dotnet/dotnet.exe",
            "args": [
                "publish",
                "${workspaceFolder}/GXPEngine/GXPEngine.csproj",
                "-c",
                "Debug",
                "-nologo"
            ],
            "options": {
                "env": {
                    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
                }
            },
            "problemMatcher": "$msCompile",
            "group": "build"
        }
    ]
}
