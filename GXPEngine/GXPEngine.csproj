<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Builds the game to WebAssembly with .NET NativeAOT-LLVM.

      dotnet publish GXPEngine/GXPEngine.csproj -c Release

    Output (paths relative to the repository root, where index.html lives):
      wasm/game.wasm        the game, engine and level files (Levels/*.tmx are embedded)
      assets/...            a copy of GXPEngine/Assets, fetched by the JS host at runtime
      assets/manifest.json  every file under assets/, so the host can preload images and fonts

    Toolchain (installed repo-locally in .tools/, which is gitignored):
      - .NET 10 SDK in .tools/dotnet (from https://dot.net/v1/dotnet-install.ps1 -Channel 10.0)
      - WASI SDK 29 in .tools/wasi-sdk, found through WASI_SDK_PATH (defaults to that folder)
        https://github.com/WebAssembly/wasi-sdk/releases/tag/wasi-sdk-29
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>GXPEngine</RootNamespace>
    <AssemblyName>GXPEngine</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The original game code predates these analyzers; keep the build output readable. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS0618;CS8981;IL2026;IL2057;IL2058;IL2065;CA2200;IL2072;IL2075;IL2077;IL2080;IL2104;IL3050;IL3053</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- NativeAOT-LLVM: a WASI "reactor" module. The JS host owns the frame loop and
         calls the exports in Web/WebRuntime.cs (_start, engine_layout, engine_frame). -->
    <OutputType>Library</OutputType>
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <NativeLib>Shared</NativeLib>
    <!-- Plain wasm-ld output: a core module browsers can instantiate, not a WASI component. -->
    <LinkerFlavor>lld</LinkerFlavor>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <InvariantTimezone>true</InvariantTimezone>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- Levels are local XML: keep System.Xml from linking in an HTTP client (wasi:http) for external entities. -->
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>

    <RepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</RepoRoot>
    <WASI_SDK_PATH Condition="'$(WASI_SDK_PATH)' == ''">$(RepoRoot).tools/wasi-sdk</WASI_SDK_PATH>
    <WebWasmDir>$(RepoRoot)wasm/</WebWasmDir>
    <WebAssetsDir>$(RepoRoot)assets/</WebAssetsDir>
  </PropertyGroup>

  <PropertyGroup>
    <IlcLlvmVersion>10.0.0-rc.1.26357.1</IlcLlvmVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.DotNet.ILCompiler.LLVM" Version="$(IlcLlvmVersion)" />
    <PackageReference Include="runtime.$(NETCoreSdkPortableRuntimeIdentifier).Microsoft.DotNet.ILCompiler.LLVM" Version="$(IlcLlvmVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tiled creates level objects by class name, and the managers find Update() and
         OnCollision() by reflection, so nothing in this assembly may be trimmed away. -->
    <TrimmerRootAssembly Include="$(AssemblyName)" />

    <!-- Levels are compiled into the module; AssetPath.OpenLevel reads them back. -->
    <EmbeddedResource Include="Levels\**\*.tmx" LogicalName="levels/%(RecursiveDir)%(Filename)%(Extension)" />

    <Compile Remove="bin\**;obj\**" />
    <None Remove="bin\**;obj\**" />
  </ItemGroup>

  <!-- After publishing: put game.wasm next to index.html and mirror Assets/ into assets/. -->
  <Target Name="CopyToWebRoot" AfterTargets="Publish">
    <ItemGroup>
      <_GameWasm Include="$(PublishDir)$(AssemblyName).wasm" />
      <_GameAssets Include="$(MSBuildProjectDirectory)\Assets\**\*" />
      <_ManifestEntry Include="@(_GameAssets->'%(RecursiveDir)%(Filename)%(Extension)'->Replace('\', '/'))" />
    </ItemGroup>
    <Error Condition="!Exists('@(_GameWasm)')" Text="Expected the published module at @(_GameWasm)." />

    <Copy SourceFiles="@(_GameWasm)" DestinationFiles="$(WebWasmDir)game.wasm" />
    <Copy SourceFiles="@(_GameAssets)" DestinationFiles="@(_GameAssets->'$(WebAssetsDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

    <PropertyGroup>
      <_ManifestJson>[
  &quot;@(_ManifestEntry, '&quot;,
  &quot;')&quot;
]</_ManifestJson>
    </PropertyGroup>
    <WriteLinesToFile File="$(WebAssetsDir)manifest.json" Lines="$(_ManifestJson)" Overwrite="true" WriteOnlyWhenDifferent="true" />

    <Message Importance="high" Text="Web build: $(WebWasmDir)game.wasm, @(_GameAssets->Count()) assets in $(WebAssetsDir)" />
  </Target>
</Project>
